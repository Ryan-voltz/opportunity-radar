# OPPORTUNITY RADAR SERVER ENVIRONMENT CONFIGURATION
# NEVER COMMIT REAL PRODUCTION SECRETS TO SOURCE CONTROL

PORT=3001
NODE_ENV=production
ALLOWED_ORIGIN=http://localhost:5173

# AI & LLM PROVIDERS (Keep strictly on server)
GEMINI_API_KEY=
OPENAI_API_KEY=

# DATABASE CONFIGURATION
DATABASE_URL=postgresql://user:password@localhost:5432/opportunity_radar?schema=public

# RATE LIMITING & CACHE
CACHE_TTL_MS=300000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
