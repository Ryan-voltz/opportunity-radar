# OPPORTUNITY RADAR SERVER ENVIRONMENT CONFIGURATION
# NEVER COMMIT REAL PRODUCTION SECRETS TO SOURCE CONTROL

PORT=3001
NODE_ENV=production
ALLOWED_ORIGIN=http://localhost:5173

# AI & LLM PROVIDERS (Keep strictly on server)
GEMINI_API_KEY=
OPENAI_API_KEY=

# DATABASE CONFIGURATION (100% FREE CLOUD POSTGRESQL OR LOCAL PERSISTENCE)
# -------------------------------------------------------------------------
# O Opportunity Radar opera automaticamente com persistência segura local ou em nuvem.
# Para ativar a sincronização na nuvem 100% gratuita, use qualquer um dos serviços abaixo:
#
# 1. Supabase (500MB Gratuito, Sem Cartão):
# DATABASE_URL=postgresql://postgres.xxxx:your_password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# 2. Neon Serverless Postgres (500MB Gratuito, Sem Cartão):
# DATABASE_URL=postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# Se DATABASE_URL não for informada, o sistema ativa o motor de armazenamento atômico persistente (zero custo).
DATABASE_URL=

# RATE LIMITING & CACHE
CACHE_TTL_MS=300000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
