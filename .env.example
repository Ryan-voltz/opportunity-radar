# ==============================================================================
# OPPORTUNITY RADAR — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env (or configure in Vercel Project Settings > Environment Variables).
# IMPORTANT: NEVER commit real credentials, production secrets or API keys to GitHub!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=development # 'development' | 'production' | 'test'

# CORS Allowed Origin (In Vercel Production, set to your production domain)
# Example: https://opportunity-radar.vercel.app
ALLOWED_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. CLIENT-SIDE VARIABLES (Vite requires VITE_ prefix to expose to browser)
# ------------------------------------------------------------------------------
# Leave blank to use relative '/api' (recommended for Vercel unified deployments & Vite dev proxy)
# Or set to full backend URL if running server as a detached microservice (e.g. Railway, Render)
# Example: https://api.opportunityradar.com
VITE_API_URL=

# ------------------------------------------------------------------------------
# 3. ARTIFICIAL INTELLIGENCE & LLM APIS (SERVER-ONLY SECRETS)
# ------------------------------------------------------------------------------
# Google Gemini API Key for autonomous market research, synthesis & opportunity discovery
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) OpenAI API Key for fallback embeddings & multimodal parsing
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 4. DATABASE CONFIGURATION (POSTGRESQL)
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL (Supabase, Neon, AWS RDS, Vercel Postgres)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/opportunity_radar?sslmode=prefer

# ------------------------------------------------------------------------------
# 5. IN-MEMORY CACHE & RATE LIMITING
# ------------------------------------------------------------------------------
CACHE_TTL_MS=300000            # 5 minutes in ms
RATE_LIMIT_WINDOW_MS=900000    # 15 minutes window in ms
RATE_LIMIT_MAX=200             # Max requests per IP within rate limit window
AI_RATE_LIMIT_MAX=25           # Max AI inferences per minute per IP
